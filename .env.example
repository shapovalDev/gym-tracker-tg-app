# ---------------------------------------------------------------------------
# Database (PostgreSQL). Locally: docker compose. Production: Supabase.
# DATABASE_URL  - runtime connection. On Supabase use the *transaction pooler*
#                 (port 6543) for serverless hosting.
# DIRECT_URL    - direct/session connection used only by Prisma migrations.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://gym:gym@localhost:5544/gym
DIRECT_URL=postgresql://gym:gym@localhost:5544/gym

# ---------------------------------------------------------------------------
# Telegram
# TELEGRAM_BOT_TOKEN       - from @BotFather. Server-only. NEVER prefix with NEXT_PUBLIC_.
# TELEGRAM_WEBHOOK_SECRET  - random string; Telegram sends it back in a header.
# PUBLIC_APP_URL           - public HTTPS URL of the Mini App (e.g. https://gym.vercel.app)
# INIT_DATA_MAX_AGE_SECONDS- how long a Telegram launch (initData) stays valid.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-random-string
PUBLIC_APP_URL=http://localhost:3000
INIT_DATA_MAX_AGE_SECONDS=604800

# ---------------------------------------------------------------------------
# Local development only. Enables GET /api/v1/dev/init-data which returns
# initData *signed with your real bot token* for a fake dev user, so the normal
# verification path is used. The server refuses to start if this is "true"
# while NODE_ENV=production.
# ---------------------------------------------------------------------------
ALLOW_DEV_AUTH=true
DEV_TELEGRAM_USER_ID=100000001

# Port for the standalone API server (packages/api, optional)
API_PORT=4000
